# Configuración del entorno - Reto 1 Vivienda Euskadi

# Configuración de HDFS (WebHDFS)
HDFS_NAMENODE_HOST=localhost
HDFS_NAMENODE_PORT=9870
HDFS_USER=hadoop
HDFS_BASE_DIR=/data/reto1
# En entornos sin cluster HDFS activo, permite usar emulación local para pruebas y desarrollo
HDFS_SIMULATION_MODE=false

# Configuración de Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=euskadi-anuncios-inmobiliarios
KAFKA_CONSUMER_GROUP=euskadi-analisis-group

# Modo simulación Kafka (en caso de broker no disponible para tests)
KAFKA_SIMULATION_MODE=false
